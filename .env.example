# Copy this to .env.local and fill in real values from your Supabase
# project's Settings → API page. Never commit .env.local.

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# The service_role key (NOT the anon/public key). This is a secret — it
# bypasses Row Level Security entirely, which is why it's only ever read
# server-side in lib/supabaseAdmin.js and never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
