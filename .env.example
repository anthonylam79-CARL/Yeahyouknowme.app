# Copy this to .env.local and fill in real values from your Supabase
# project's Settings → API page. Never commit .env.local.

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# The service_role key (NOT the anon/public key). This is a secret — it
# bypasses Row Level Security entirely, which is why it's only ever read
# server-side in lib/supabaseAdmin.js and never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — powers the "lost your results link?" recovery email (see
# app/api/recover/route.js). Get a free API key at https://resend.com.
# Without it, recovery requests are accepted but no email is actually sent
# (silently no-ops, logged server-side).
RESEND_API_KEY=

# Optional. Defaults to Resend's shared testing address, which only
# delivers to the email you signed up to Resend with. Once you verify your
# own domain in Resend, set this to something like
# "Yeah You Know Me <noreply@yourdomain.com>" so it can email anyone.
RESEND_FROM_EMAIL=

# Required for the "$1.99 to unlock full insights" paywall. Get these from
# the Stripe dashboard (Developers → API keys / Webhooks). Use the "sk_test_"
# key while testing, swap to "sk_live_" once you're ready for real payments.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint at /api/stripe/webhook (Developers
# → Webhooks → your endpoint → "Signing secret"). Without this, payments
# succeed in Stripe but the quiz never actually unlocks.
STRIPE_WEBHOOK_SECRET=
